# Never store API credentials, even in a private repository.
.env*
**/.env*
*.pem
*.key
auth.json
credentials.json
credentials.*.json
service-account*.json
.codex/
.secrets/

# Dependencies and local generated output.
node_modules/
dist/
coverage/
playwright-report/
test-results/
*.log
.DS_Store

