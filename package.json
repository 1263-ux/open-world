{
  "name": "tyut-campus-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:hks && vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run build:hks && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "build:hks": "npm --prefix games/hks run build"
  },
  "dependencies": {
    "vue": "3.5.44",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@types/three": "0.186.0",
    "@types/node": "^24.0.0",
    "vite": "8.3.5",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "@eslint/js": "^10.0.0",
    "typescript-eslint": "8.72.1",
    "eslint-plugin-vue": "10.12.0"
  }
}
