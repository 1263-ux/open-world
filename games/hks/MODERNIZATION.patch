+      a.noiseHighpass, a.noiseLowpass, a.crackFilter, a.crackQ,
+      SOUND_CONFIG.pitchVar.impact, pan, pri);
+    // Sharp edge layer — cutting through
+    this.playNoise(0.08, 0.03, 3000, undefined,
+      undefined, 3, 0.15, pan, pri);
